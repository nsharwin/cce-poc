# Linux kernel config skeleton for the CCE Firecracker microVM rootfs.
#
# Build with the matching cce-kernel-build pipeline; the resulting
# `vmlinux-cce` image is digest-pinned in ops/firecracker/jailer.json
# and re-verified at every dispatch.
#
# Required:
CONFIG_KVM=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=n
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_PIDS_CGROUP=y
CONFIG_CPU_FREQ=n
# Hardening:
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=n
CONFIG_SECCOMP=y
CONFIG_BPF=y
CONFIG_RANDOMIZE_BASE=y
# Disabled to shrink attack surface:
CONFIG_NET=n
CONFIG_INET=n
CONFIG_BLUETOOTH=n
CONFIG_WIRELESS=n
CONFIG_USB_SUPPORT=n
